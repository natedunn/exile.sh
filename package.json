{
  "name": "exile-sh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src shared convex/lib convex/functions --ignore-pattern \"**/generated/**\" --ignore-pattern \"**/_generated/**\"",
    "format": "prettier --write src shared convex docs e2e *.json *.ts *.md",
    "check": "prettier --check src shared convex docs e2e *.json *.ts *.md",
    "typecheck": "tsc --noEmit && bun run typecheck:convex",
    "codegen": "kitcn codegen",
    "convex:dev": "kitcn dev",
    "typecheck:convex": "tsc --noEmit --project convex/functions/tsconfig.json",
    "convex:codegen": "kitcn codegen",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types"
  },
  "dependencies": {
