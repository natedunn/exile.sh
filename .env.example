# `bun run dev` creates these values for a worktree-local anonymous backend.
# Set them only when using `bun run dev:shared` with a shared cloud deployment.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site
VITE_SITE_URL=http://localhost:3000
# Configure GGG_CONTACT and COLLECTOR_ENABLED server-side in Convex.

# Discord auth backend configuration belongs in gitignored convex/.env:
# SITE_URL=https://exile.sh (local dev startup derives its own Portless origin)
# DISCORD_CLIENT_ID=<Discord OAuth2 client ID>
# DISCORD_CLIENT_SECRET=<Discord OAuth2 client secret; never VITE_*>
# OAUTH_PROXY_SECRET=<same dedicated secret for production, previews, and local auth>
# Kitcn manages BETTER_AUTH_SECRET and JWKS. See docs/discord-auth.md.
